{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Zanes File Explorer",
  "version": "0.3.0",
  "identifier": "com.zane.fileexplorer",
  "build": { "frontendDist": "../src" },
  "app": {
    "withGlobalTauri": true,
    "windows": [{ "label": "main", "title": "Zane's File Explorer", "width": 1440, "height": 880, "backgroundColor": "#232328" }],
    "security": { "csp": null, "assetProtocol": { "enable": true, "scope": ["**"] } }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"]
  }
}
